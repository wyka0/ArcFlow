# ArcFlow — example environment configuration.
# Placeholders ONLY. Copy to .env.local, fill in your own values, and NEVER commit real values.

# --- Arc mainnet (public configuration) ---
# RPC endpoint for the Arc chain (chain ID 5042)
ARC_RPC_URL=https://rpc.mainnet.arc.io
# Verified Arc USDC proxy (constructor argument of ArcFlowV2)
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- Deployment ---
# Deployment EOA private key. Supply securely at deploy time (masked entry /
# keystore / hardware wallet). NEVER commit, paste into chat, or place on a
# recorded command line.
DEPLOYER_PRIVATE_KEY=

# --- Smoke test (Phase 19.7 fail-closed mechanism) ---
# Must be set explicitly to the deployment-receipt-verified ArcFlowV2 address.
# Missing/forbidden/code-less values are rejected. There is no default.
SMOKE_TEST_V2_ADDRESS=

# --- ArcFlow V1 (existing deployment, public) ---
NEXT_PUBLIC_ARCFLOW_CONTRACT_ADDRESS=0x3fB50a2aDc5FCba60274eDb976E12caDC6FDb8c2

# --- Application configuration (supply your own values) ---
# The Next.js application expects PostgreSQL/Neon and auth configuration for
# its payment-request backend. Variable names used by the app:
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_DATABASE=
# NEON_AUTH_BASE_URL=
# NEON_PROJECT_ID=
# VITE_NEON_AUTH_URL=

# --- Optional frontend overrides (read by scripts/preflight.mjs) ---
# NEXT_PUBLIC_ARC_RPC_URL=
# NEXT_PUBLIC_ARCFLOW_V2_CONTRACT_ADDRESS=
